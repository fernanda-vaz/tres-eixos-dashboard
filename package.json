{
  "name": "tres-eixos-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestão para meu negócio de impressão 3D.",
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "api",
    "web",
    "e2e"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration -w api",
    "deps:check": "npm run deps:check -w api",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run deps:check && npm test",
    "e2e": "npm run e2e -w e2e"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernanda-vaz/tres-eixos-dashboard.git"
  },
  "license": "ISC"
}
