POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app_dev_password@localhost:5434/app
PORT=8080
# Gere um segredo próprio, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres
# Banco dos testes de integração: o nome precisa terminar em _test (o schema é recriado a cada execução)
TEST_DATABASE_URL=postgresql://app:app_dev_password@localhost:5434/app_test
# Atrás de proxy reverso (nginx/Caddy): quantos proxies são confiáveis
# TRUST_PROXY=1
# Cookie Secure: padrão true quando NODE_ENV=production
# COOKIE_SECURE=true
# Docker Compose: portas publicadas em 127.0.0.1 (troque se 8080 estiver ocupada)
# API_HOST_PORT=8080
# Worker do outbox: sem esta variável, os eventos são escritos no log do worker
# OUTBOX_WEBHOOK_URL=https://exemplo.com/eventos
