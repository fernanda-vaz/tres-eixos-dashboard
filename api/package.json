{
  "name": "tres-eixos-dashboard",
  "version": "1.0.0",
  "description": "Sistema de gestão para meu negócio de impressão 3D.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "node --env-file=../.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file=../.env dist/src/server.js",
    "migrate": "node --env-file=../.env src/scripts/migrate.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "test:integration": "node --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "user:create": "node --env-file=../.env --import tsx src/scripts/create-user.ts",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file=../.env --import tsx src/worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernanda-vaz/tres-eixos-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/fernanda-vaz/tres-eixos-dashboard/issues"
  },
  "homepage": "https://github.com/fernanda-vaz/tres-eixos-dashboard#readme",
  "private": true,
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "csrf-sync": "4.2.1",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
